#!/bin/bash

# Define variables
IMAGE_NAME="samburi/easyvalues"
TAG="2.0.4"
FULL_IMAGE="$IMAGE_NAME:$TAG"

# Check if Buildx builder exists, create or append if necessary
echo "Setting up Docker Buildx..."
if docker buildx inspect multiarch-builder > /dev/null 2>&1; then
  echo "Builder 'multiarch-builder' already exists, reusing it..."
  docker buildx use multiarch-builder
else
  echo "Creating new Buildx builder 'multiarch-builder'..."
  docker buildx create --name multiarch-builder --use || { echo "Failed to create Buildx builder"; exit 1; }
fi

# Bootstrap the builder
docker buildx inspect --bootstrap || { echo "Failed to bootstrap Buildx"; exit 1; }

echo "Building multi-arch Docker image: $FULL_IMAGE for linux/amd64,linux/arm64"
docker buildx build --platform linux/amd64,linux/arm64 \
  -t "$FULL_IMAGE" \
  --push .

if [ $? -ne 0 ]; then
  echo "Docker Buildx build failed. Exiting..."
  exit 1
fi

echo "Docker image $FULL_IMAGE built and pushed successfully for multiple architectures!"

# Clean up Buildx builder (optional, comment out if you want to keep it)
# docker buildx rm multiarch-builder
